<Window x:Class="MedCompanion.Dialogs.OcrTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Banc d'essai OCR — GLM-OCR local"
        Height="760" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">

    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2980B9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bandeau état du modèle -->
        <Border Grid.Row="0" x:Name="StatusBanner" Background="#ECF0F1" CornerRadius="5"
                Padding="12,9" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusIcon" Text="⏳" FontSize="15" Margin="0,0,9,0"/>
                <TextBlock x:Name="StatusText" Text="Vérification du modèle..."
                           VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Barre d'actions -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="LoadBtn" Style="{StaticResource Btn}"
                    Content="📂  Charger une image" Click="LoadBtn_Click"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="TextBtn" Style="{StaticResource BtnPrimary}" IsEnabled="False"
                        Content="1. Texte complet" Click="TextBtn_Click"/>
                <Button x:Name="JsonBtn" Style="{StaticResource BtnPrimary}" IsEnabled="False"
                        Content="2. Extraction JSON" Click="JsonBtn_Click"/>
                <Button x:Name="StripBtn" Style="{StaticResource BtnPrimary}" IsEnabled="False"
                        Content="3. Bande contrainte" Click="StripBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Corps : image | paramètres+sortie -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDE1E4" BorderThickness="1"
                    CornerRadius="5" Padding="8">
                <Grid>
                    <TextBlock x:Name="NoImageHint" Text="Aucune image chargée"
                               Foreground="#B2BEC3" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="13"/>
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Paramètres des méthodes 2 et 3 -->
                <Border Grid.Row="0" Background="White" BorderBrush="#DDE1E4" BorderThickness="1"
                        CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Lbl}"
                                       Text="Schéma JSON attendu (méthode 2)"/>
                            <TextBox x:Name="SchemaBox" Height="86" AcceptsReturn="True"
                                     FontFamily="Consolas" FontSize="11.5"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Lbl}"
                                       Text="Caractères autorisés (méthode 3)"/>
                            <TextBox x:Name="CharsetBox" Height="24"
                                     Text="lettres majuscules A-Z"/>
                            <TextBlock Style="{StaticResource Lbl}" Margin="0,8,0,3"
                                       Text="Nombre de cases (vide = inconnu)"/>
                            <TextBox x:Name="LengthBox" Height="24" Text="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sortie brute -->
                <Border Grid.Row="1" Background="White" BorderBrush="#DDE1E4" BorderThickness="1"
                        CornerRadius="5" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Lbl}"
                                   Text="Sortie brute du modèle"/>
                        <TextBox Grid.Row="1" x:Name="OutputBox" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="12"
                                 BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Pied -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="12"
                       Foreground="#7F8C8D" Text="Prêt."/>
            <Button HorizontalAlignment="Right" Style="{StaticResource Btn}" Margin="0"
                    Content="Fermer" Click="CloseBtn_Click"/>
        </Grid>
    </Grid>
</Window>
