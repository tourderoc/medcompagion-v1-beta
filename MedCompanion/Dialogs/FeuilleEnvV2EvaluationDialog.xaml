<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MedCompanion.Dialogs.FeuilleEnvV2EvaluationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compléter la feuille"
        Width="560" SizeToContent="Height"
        MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6FA"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre feuille -->
        <TextBlock x:Name="TitreText" Grid.Row="0" FontSize="15" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="0,0,0,4"/>

        <!-- Provenance -->
        <TextBlock x:Name="ProvenanceText" Grid.Row="1" FontSize="11" FontStyle="Italic"
                   Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,0,0,4"/>

        <!-- Rappel trois états -->
        <TextBlock Grid.Row="2" FontSize="10.5" Foreground="#95A5A6" TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Text="Coché = oui · décoché = non · carré plein = non renseigné (un vide n'est pas un non). La source de chaque item est rappelée entre crochets."/>

        <!-- Nervures + items (checkboxes trois états) -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18">
            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="6" Padding="14,10">
                <StackPanel x:Name="ItemsHost"/>
            </Border>
        </ScrollViewer>

        <!-- Boutons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Click="Annuler_Click"
                    Padding="14,7" Background="White" Foreground="#555"
                    BorderBrush="#CCC" BorderThickness="1"
                    FontSize="12" FontFamily="Segoe UI" Cursor="Hand" Margin="0,0,10,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="✓ Sauvegarder et fermer" Click="Sauvegarder_Click"
                    Padding="14,7" Background="#27AE60" Foreground="White" BorderThickness="0"
                    FontSize="12" FontFamily="Segoe UI" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#229954"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
