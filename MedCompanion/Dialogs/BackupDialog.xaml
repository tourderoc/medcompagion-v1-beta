<Window x:Class="MedCompanion.Dialogs.BackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💾 Sauvegarde"
        Height="420" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Destination -->
        <Border Grid.Row="0" Background="#E7F3FF" Padding="15" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="PhaseTextBlock"
                           FontWeight="Bold" FontSize="13" Foreground="#0066CC"
                           Text="Préparation…" Margin="0,0,0,4"/>
                <TextBlock x:Name="DestinationTextBlock"
                           FontSize="11" Foreground="#0066CC" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Barre de progression -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <ProgressBar x:Name="ProgressBarPrincipale"
                         Height="22" Minimum="0" Maximum="100" Value="0"
                         Foreground="#28A745" Background="#E0E0E0" BorderThickness="0"/>
            <TextBlock x:Name="FichierTextBlock"
                       FontSize="11" Foreground="#555" Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Compteurs -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Fichiers" FontSize="10" Foreground="Gray"/>
                <TextBlock x:Name="CompteurFichiers" Text="—" FontFamily="Consolas"
                           FontSize="14" FontWeight="Bold" Foreground="#007BFF"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Volume" FontSize="10" Foreground="Gray"/>
                <TextBlock x:Name="CompteurOctets" Text="—" FontFamily="Consolas"
                           FontSize="14" FontWeight="Bold" Foreground="#007BFF"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Écoulé" FontSize="10" Foreground="Gray"/>
                <TextBlock x:Name="CompteurEcoule" Text="—" FontFamily="Consolas"
                           FontSize="14" FontWeight="Bold" Foreground="#007BFF"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="Restant" FontSize="10" Foreground="Gray"/>
                <TextBlock x:Name="CompteurRestant" Text="—" FontFamily="Consolas"
                           FontSize="14" FontWeight="Bold" Foreground="#007BFF"/>
            </StackPanel>
        </Grid>

        <!-- Compte rendu -->
        <Border Grid.Row="3" Background="White" BorderBrush="#DDD" BorderThickness="1"
                CornerRadius="5" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="CompteRenduTextBlock"
                           FontSize="12" TextWrapping="Wrap" Foreground="#333"
                           Text="La sauvegarde n'ajoute que les nouveautés et les modifications. Rien n'est jamais supprimé du disque de sauvegarde."/>
            </ScrollViewer>
        </Border>

        <!-- Boutons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnJournal" Content="Voir le journal"
                    Click="BtnJournal_Click"
                    Margin="0,0,10,0"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#6C757D" Foreground="White" Width="140"
                    Visibility="Collapsed"/>

            <Button x:Name="BtnAnnuler" Content="Annuler"
                    Click="BtnAnnuler_Click"
                    Margin="0,0,10,0"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#DC3545" Foreground="White" Width="110"/>

            <Button x:Name="BtnFermer" Content="Fermer"
                    Click="BtnFermer_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#28A745" Foreground="White" Width="110"
                    IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
