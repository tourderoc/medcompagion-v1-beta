<Window x:Class="MedCompanion.Dialogs.EnvSaisieDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Loaded="Window_Loaded"
        Title="Dépouillement de la feuille environnement"
        Height="800" Width="1220"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="600"/>
        </Grid.ColumnDefinitions>

        <!-- Bandeau -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <TextBlock Text="Dépouillement de la feuille environnement" FontSize="16"
                       FontWeight="Bold" Foreground="#1A3A6A"/>
            <TextBlock FontSize="11" Foreground="#7B8FA5" Margin="0,3,0,0">
                <Run Text="{Binding AvancementText, Mode=OneWay}"/>
                <Run Text="· laissez vide une ligne que le parent n'a pas remplie."/>
            </TextBlock>
        </StackPanel>

        <!-- La feuille scannée — visualiseur PDF d'Edge, comme le formulaire de complétion :
             c'est de l'écriture manuscrite qu'on relit, il faut pouvoir zoomer et faire défiler. -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#D6E2EC"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <wv2:WebView2 x:Name="PdfWebView" Visibility="Collapsed"/>
                <Image x:Name="ScanImage" Stretch="Uniform" StretchDirection="Both"
                       Visibility="Collapsed"/>
                <TextBlock x:Name="PdfFallback" Text="Chargement de la feuille…"
                           FontSize="12" Foreground="#93A7BD"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Les 30 réponses, précédées de QUI a rempli la feuille -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Informateur : un 5/6 de la mère qui vit avec l'enfant et un 5/6 d'un père qui le
                 voit deux week-ends par mois ne se lisent pas pareil. -->
            <Border Grid.Row="0" Background="White" BorderBrush="#D6E2EC" BorderThickness="1"
                    CornerRadius="6" Padding="12,9" Margin="0,0,6,10">
                <StackPanel>
                    <TextBlock Text="Qui a rempli cette feuille ?" FontSize="11"
                               FontWeight="SemiBold" Foreground="#1A3A6A"/>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <ItemsControl>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <Button Command="{Binding ChoisirInformateurCommand}" CommandParameter="mere"
                                    Cursor="Hand" Margin="0,0,6,0" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="M" Background="#F0F4F8" BorderBrush="#CBD8E4"
                                                BorderThickness="1" CornerRadius="4" Padding="14,5">
                                            <TextBlock x:Name="Mt" Text="Mère" FontSize="10.5"
                                                       FontWeight="SemiBold" Foreground="#7B8FA5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding EstMere}" Value="True">
                                                <Setter TargetName="M" Property="Background" Value="#004098"/>
                                                <Setter TargetName="M" Property="BorderBrush" Value="#1A3A6A"/>
                                                <Setter TargetName="Mt" Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Command="{Binding ChoisirInformateurCommand}" CommandParameter="pere"
                                    Cursor="Hand" Margin="0,0,6,0" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="P" Background="#F0F4F8" BorderBrush="#CBD8E4"
                                                BorderThickness="1" CornerRadius="4" Padding="14,5">
                                            <TextBlock x:Name="Pt" Text="Père" FontSize="10.5"
                                                       FontWeight="SemiBold" Foreground="#7B8FA5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding EstPere}" Value="True">
                                                <Setter TargetName="P" Property="Background" Value="#004098"/>
                                                <Setter TargetName="P" Property="BorderBrush" Value="#1A3A6A"/>
                                                <Setter TargetName="Pt" Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Command="{Binding ChoisirInformateurCommand}" CommandParameter="autre"
                                    Cursor="Hand" Margin="0,0,12,0" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="A" Background="#F0F4F8" BorderBrush="#CBD8E4"
                                                BorderThickness="1" CornerRadius="4" Padding="14,5">
                                            <TextBlock x:Name="At" Text="Autre" FontSize="10.5"
                                                       FontWeight="SemiBold" Foreground="#7B8FA5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding EstAutre}" Value="True">
                                                <Setter TargetName="A" Property="Background" Value="#004098"/>
                                                <Setter TargetName="A" Property="BorderBrush" Value="#1A3A6A"/>
                                                <Setter TargetName="At" Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </ItemsControl>
                        <TextBlock Text="Prénom et lien :" FontSize="10" Foreground="#7B8FA5"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding InformateurNom, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180" FontSize="10.5" Padding="5,3"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#CBD8E4" BorderThickness="1"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Blocs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#D6E2EC" BorderThickness="1"
                                CornerRadius="6" Margin="0,0,6,10">
                            <StackPanel>
                                <Border Background="#F4F8FB" CornerRadius="6,6,0,0"
                                        BorderBrush="#E8EEF5" BorderThickness="0,0,0,1" Padding="12,7">
                                    <!-- Ni score ni couleur ici, à la différence de la feuille de
                                         l'enfant : une feuille d'environnement se lit sur ses DEUX
                                         moitiés, et un chiffre affiché sur la seule part du parent
                                         aurait l'air d'un résultat. On dit donc ce qui manque. -->
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                       FontWeight="SemiBold" Foreground="#1A3A6A"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SousTitre}" FontSize="10"
                                                       Foreground="#93A7BD" FontStyle="Italic"
                                                       VerticalAlignment="Center" Margin="7,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding AttenteMedecinText}" FontSize="9.5"
                                                       Foreground="#B0BFCE" FontStyle="Italic"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#EBF3FA" CornerRadius="3"
                                                    BorderBrush="#CBD8E4" BorderThickness="1"
                                                    Padding="8,2" MinWidth="38">
                                                <TextBlock Text="{Binding AvancementText}" FontSize="10.5"
                                                           FontWeight="Bold" Foreground="#1A3A6A"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,2,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Numero}"
                                                           FontSize="9" Foreground="#B0BFCE"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Texte}"
                                                           FontSize="10.5" Foreground="#2C3E50"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Command="{Binding OuiCommand}" Cursor="Hand"
                                                            Background="Transparent" BorderThickness="0"
                                                            Margin="0,0,4,0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="B" Width="44" Height="24"
                                                                        CornerRadius="4" Background="#F0F4F8"
                                                                        BorderBrush="#CBD8E4" BorderThickness="1">
                                                                    <TextBlock x:Name="T" Text="OUI" FontSize="9.5"
                                                                               FontWeight="SemiBold" Foreground="#7B8FA5"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding EstOui}" Value="True">
                                                                        <Setter TargetName="B" Property="Background" Value="#27AE60"/>
                                                                        <Setter TargetName="B" Property="BorderBrush" Value="#1E8449"/>
                                                                        <Setter TargetName="T" Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="B" Property="BorderBrush" Value="#3498DB"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <Button Command="{Binding NonCommand}" Cursor="Hand"
                                                            Background="Transparent" BorderThickness="0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="B2" Width="44" Height="24"
                                                                        CornerRadius="4" Background="#F0F4F8"
                                                                        BorderBrush="#CBD8E4" BorderThickness="1">
                                                                    <TextBlock x:Name="T2" Text="NON" FontSize="9.5"
                                                                               FontWeight="SemiBold" Foreground="#7B8FA5"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding EstNon}" Value="True">
                                                                        <Setter TargetName="B2" Property="Background" Value="#E74C3C"/>
                                                                        <Setter TargetName="B2" Property="BorderBrush" Value="#C0392B"/>
                                                                        <Setter TargetName="T2" Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="B2" Property="BorderBrush" Value="#3498DB"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Grid>

        <!-- Pied -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <TextBlock x:Name="PiedTb" VerticalAlignment="Center" FontSize="10.5" Foreground="#7B8FA5"
                       TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                       Text="Ces réponses rejoindront vos 14 items dans la fiche de la séance — c'est une fois les deux moitiés réunies que les nervures prendront leur couleur."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Modèle qui lit les cases. Indépendant du modèle de texte : la lecture d'image
                     a ses propres exigences, et c'est le même sélecteur que le formulaire. -->
                <TextBlock Text="Lecture :" VerticalAlignment="Center" FontSize="10.5"
                           Foreground="#7B8FA5" Margin="0,0,6,0"/>
                <ComboBox x:Name="VisionModelCombo" Width="160" FontSize="11" Margin="0,0,12,0"
                          VerticalContentAlignment="Center"
                          ToolTip="Modèle qui lit les cases cochées. Le changer redémarre le moteur (~6-10 s)."
                          SelectionChanged="VisionModelCombo_SelectionChanged"/>

                <Button x:Name="LireBtn" Click="Lire_Click" Cursor="Hand" Margin="0,0,10,0"
                        ToolTip="Lit les 22 cases sur l'image — à vérifier ensuite, ligne par ligne">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Lb" Background="#16A085" CornerRadius="5" Padding="14,8">
                                <TextBlock x:Name="Lt" Text="⚡ Lecture automatique" Foreground="White"
                                           FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Lb" Property="Background" Value="#12876F"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Lb" Property="Background" Value="#B8C6D6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Click="Annuler_Click" Content="Annuler" Padding="14,7" Margin="0,0,8,0"
                        Cursor="Hand" Background="White" BorderBrush="#D6E2EC" BorderThickness="1"/>
                <Button Click="Enregistrer_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Sb" Background="#004098" CornerRadius="5" Padding="18,8">
                                <TextBlock Text="Enregistrer les réponses" Foreground="White"
                                           FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Sb" Property="Background" Value="#1A5296"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
