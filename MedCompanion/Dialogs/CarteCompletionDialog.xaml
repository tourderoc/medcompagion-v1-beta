<Window x:Class="MedCompanion.Dialogs.CarteCompletionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compléter la carte du patient"
        Width="620" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitreTexte" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Med a relu les notes du dossier. Corrigez ce qui doit l'être, videz ce qui est faux : seul ce que vous validez entre dans la carte. Un champ laissé vide ne vous sera plus proposé."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Champs">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Libelle}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#334155" VerticalAlignment="Top" Margin="0,5,8,0" TextWrapping="Wrap"/>
                            <StackPanel Grid.Column="1">
                                <TextBox Text="{Binding Valeur, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"
                                         Padding="6,4" TextWrapping="Wrap" AcceptsReturn="False"/>
                                <TextBlock Text="{Binding Provenance}" FontSize="10.5" Foreground="#94A3B8" Margin="2,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuler" Width="100" Height="32" Margin="0,0,10,0" IsCancel="True" Click="Annuler_Click"/>
            <Button Content="✓ Valider" Width="120" Height="32" Background="#1E8449" Foreground="White"
                    FontWeight="SemiBold" IsDefault="True" Click="Valider_Click"/>
        </StackPanel>
    </Grid>
</Window>
