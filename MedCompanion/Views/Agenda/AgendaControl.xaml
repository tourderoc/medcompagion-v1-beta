<UserControl x:Class="MedCompanion.Views.Agenda.AgendaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MedCompanion.Views.Agenda"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Language="fr-FR"
             Background="#F8F9FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>

        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Les lignes d'heures, dessinées derrière les rendez-vous -->
        <DataTemplate x:Key="LigneHeureTemplate">
            <Border BorderBrush="#E8ECEF" BorderThickness="0,0,0,1"
                    Height="{Binding DataContext.HauteurHeure, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </DataTemplate>

        <!-- Un rendez-vous dans la grille -->
        <DataTemplate x:Key="BlocTemplate">
            <!-- Un clic ouvre le dossier du patient en mode Consultation. Le bloc n'est cliquable
                 que si Med a rapproché un dossier : sinon le curseur reste une flèche. -->
            <Border Background="{Binding CouleurFond}" BorderBrush="{Binding CouleurBord}"
                    BorderThickness="0,0,0,0" CornerRadius="3" Padding="4,2"
                    ToolTip="{Binding InfoBulle}" MouseLeftButtonUp="Bloc_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="3,1,1,1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PeutOuvrir}" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PeutOuvrir}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="#2C3E50"/>
                            </MultiDataTrigger>
                            <!-- Pas de dossier Med : liseré orange. Le doute sur le statut passe
                                 devant, en rouge — c'est le signal le plus urgent. -->
                            <DataTrigger Binding="{Binding SansDossier}" Value="True">
                                <Setter Property="BorderBrush" Value="#E67E22"/>
                                <Setter Property="BorderThickness" Value="3,1,1,1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ADouteStatut}" Value="True">
                                <Setter Property="BorderBrush" Value="#C0392B"/>
                                <Setter Property="BorderThickness" Value="3,1,1,1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- Deux TextBlock plutôt que des Run : la propriété Text d'un Run se lie en
                         TwoWay par défaut, ce qui lève une exception sur une propriété en lecture
                         seule — et la boîte d'erreur relançait la mise en page jusqu'au plantage
                         (constaté le 24/09/2026). -->
                    <StackPanel Orientation="Horizontal">
                        <!-- Un rendez-vous annulé est barré, comme chez Doctolib : la ligne reste
                             là, mais on voit d'un coup d'œil que le créneau s'est libéré. -->
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock" x:Key="TexteBloc">
                                <Setter Property="FontSize" Value="10.5"/>
                                <Setter Property="Foreground" Value="#1B2631"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EstAnnule}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter Property="Foreground" Value="#7F8C8D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{Binding Heure, Mode=OneWay}" FontWeight="Bold"
                                   Style="{StaticResource TexteBloc}"/>
                        <TextBlock Text="{Binding NomComplet, Mode=OneWay}" Margin="4,0,0,0"
                                   TextTrimming="CharacterEllipsis" Style="{StaticResource TexteBloc}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Motif}" FontSize="9.5" Foreground="#4D5C6B"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding MotifVisible, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Une colonne de jour : lignes d'heures + blocs répartis sur 12 sous-colonnes -->
        <DataTemplate x:Key="ColonneJourTemplate">
            <Border BorderBrush="#DDE3E8" BorderThickness="0,0,1,0" Background="White">
                <Grid VerticalAlignment="Top"
                      Height="{Binding DataContext.HauteurGrille, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl ItemsSource="{Binding DataContext.Heures, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  ItemTemplate="{StaticResource LigneHeureTemplate}"/>

                    <ItemsControl ItemsSource="{Binding Blocs}" ItemTemplate="{StaticResource BlocTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Column" Value="{Binding Colonne}"/>
                                <Setter Property="Grid.ColumnSpan" Value="{Binding Largeur}"/>
                                <Setter Property="Margin" Value="{Binding Marge}"/>
                                <Setter Property="Height" Value="{Binding Hauteur}"/>
                                <Setter Property="VerticalAlignment" Value="Top"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Navigation -->
            <RowDefinition Height="Auto"/>   <!-- Fraîcheur -->
            <RowDefinition Height="Auto"/>   <!-- Lecture du matin -->
            <RowDefinition Height="*"/>      <!-- Grille -->
            <RowDefinition Height="Auto"/>   <!-- Statut -->
        </Grid.RowDefinitions>

        <!-- ══ Navigation ══ -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1"
                Padding="10,8" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="◀" Click="Precedent_Click" Style="{StaticResource ToolBtn}"
                        Background="#5D6D7E" ToolTip="Jour ou semaine précédente"/>
                <Button DockPanel.Dock="Left" Content="Aujourd'hui" Click="Aujourdhui_Click"
                        Style="{StaticResource ToolBtn}" Background="#5D6D7E"/>
                <Button DockPanel.Dock="Left" Content="▶" Click="Suivant_Click" Style="{StaticResource ToolBtn}"
                        Background="#5D6D7E" ToolTip="Jour ou semaine suivante"/>

                <TextBlock DockPanel.Dock="Left" Text="{Binding Titre}" FontSize="15" FontWeight="SemiBold"
                           Foreground="#2C3E50" VerticalAlignment="Center" Margin="10,0,0,0"/>

                <!-- Outil d'essai : repartir d'une période vide pour voir ce que Med a su lire -->
                <Button DockPanel.Dock="Right" Content="{Binding LibelleVider}" Click="Vider_Click"
                        Style="{StaticResource ToolBtn}" Background="#C0392B" Margin="0,0,8,0"
                        ToolTip="Vide la période affichée dans la copie locale de Med. Doctolib n'est pas touché."/>
                <Button DockPanel.Dock="Right" Content="🔄 Mettre à jour" Click="MettreAJour_Click"
                        Style="{StaticResource ToolBtn}" Background="#8E44AD" Margin="0,0,8,0"
                        IsEnabled="{Binding LectureEnCours, Converter={StaticResource InverseBool}}"
                        ToolTip="Reprend les captures Doctolib prises aujourd'hui, les fait lire par Med et met l'agenda à jour."/>
                <Button DockPanel.Dock="Right" Content="📂 Importer l'export Doctolib" Click="Importer_Click"
                        Style="{StaticResource ToolBtn}" Margin="0,0,8,0"
                        ToolTip="Doctolib → Paramètres → Données → Exports → type « Agenda », puis importez le CSV ici"/>
                <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding ModeSemaine, Mode=TwoWay}"
                              Content="Semaine" Padding="12,5" Margin="0,0,8,0" Cursor="Hand" FontSize="12"
                              ToolTip="Basculer entre la journée et la semaine"/>
            </DockPanel>
        </Border>

        <!-- ══ Fraîcheur : le garde-fou, toujours visible ══ -->
        <Border Grid.Row="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#EAF7F0"/>
                    <Setter Property="BorderBrush" Value="#A9DFBF"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EstPerime}" Value="True">
                            <Setter Property="Background" Value="#FDEBD0"/>
                            <Setter Property="BorderBrush" Value="#F5B041"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding Fraicheur}" FontSize="12" FontWeight="SemiBold" Foreground="#2C3E50"/>
                <TextBlock Text="{Binding RappelImport}" FontSize="11" Foreground="#7A5C24" TextWrapping="Wrap"
                           Margin="0,3,0,0" Visibility="{Binding EstPerime, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- ══ Lecture du matin : les écarts entre Med et l'écran Doctolib ══ -->
        <Border Grid.Row="2" Background="#F4ECF7" BorderBrush="#D7BDE2" BorderThickness="1"
                CornerRadius="6" Padding="10,7" Margin="0,0,0,8"
                Visibility="{Binding ALecture, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ResumeLecture}" FontSize="12"
                               FontWeight="SemiBold" Foreground="#4A235A" TextWrapping="Wrap"/>
                    <Button DockPanel.Dock="Right" Content="✕" Click="FermerLecture_Click"
                            Background="Transparent" Foreground="#7D3C98" BorderThickness="0"
                            Cursor="Hand" FontSize="12" Padding="6,0"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Ecarts}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Icone}" FontSize="11" Foreground="{Binding Couleur}"
                                           Width="18"/>
                                <TextBlock Text="{Binding Titre}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#2C3E50" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#5D6D7E"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Med ne modifie rien : vérifiez ces points dans Doctolib." FontSize="10"
                           Foreground="#7D3C98" FontStyle="Italic" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══ La grille ══ -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" BorderBrush="#DDE3E8" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- En-têtes de jours -->
                    <RowDefinition Height="*"/>      <!-- Corps défilant -->
                </Grid.RowDefinitions>

                <!-- En-têtes -->
                <Grid Grid.Row="0" Background="#F4F6F7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Jours}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDE3E8" BorderThickness="0,0,1,1" Padding="6,5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EstAujourdhui}" Value="True">
                                                    <Setter Property="Background" Value="#E8F1FB"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NomJour}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1A3A6A" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Compte}" FontSize="10" Foreground="#7F8C8D"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Corps -->
                <ScrollViewer Grid.Row="1" x:Name="CorpsScroll" VerticalScrollBarVisibility="Auto"
                              SizeChanged="CorpsScroll_SizeChanged">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Règle des heures -->
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding Heures}" Background="#FBFCFC"
                                      VerticalAlignment="Top">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="{Binding DataContext.HauteurHeure, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            BorderBrush="#E8ECEF" BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding}" FontSize="10.5" Foreground="#7F8C8D"
                                                   Margin="0,2,6,0" HorizontalAlignment="Right"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Colonnes de jours + trait de l'heure courante -->
                        <Grid Grid.Column="1">
                            <ItemsControl ItemsSource="{Binding Jours}" ItemTemplate="{StaticResource ColonneJourTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border Height="2" Background="#E74C3C" VerticalAlignment="Top"
                                    Margin="{Binding MargeHeureCourante}" IsHitTestVisible="False"
                                    Visibility="{Binding HeureCouranteVisible, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding Statut}" FontSize="11" Foreground="#5D6D7E"
                   Margin="4,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
