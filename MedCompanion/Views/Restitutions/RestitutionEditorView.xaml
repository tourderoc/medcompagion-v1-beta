                                                    <TextBox Grid.Column="1" Style="{StaticResource CfFieldBox}"
                                                             AcceptsReturn="True" MinHeight="50"
                                                             Text="{Binding CfFratrie, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>

                                                <!-- Autres figures -->
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource CfLabelChip}" Margin="0,0,8,0">
                                                        <TextBlock Text="Autres figures" Style="{StaticResource CfLabelText}" TextWrapping="Wrap"/>
                                                    </Border>
                                                    <TextBox Grid.Column="1" Style="{StaticResource CfFieldBox}"
                                                             AcceptsReturn="True" MinHeight="50"
                                                             Text="{Binding CfAutresFigures, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>

                                                <!-- Points à retenir -->
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource CfLabelChip}" Margin="0,0,8,0">
                                                        <TextBlock Text="Points à retenir" Style="{StaticResource CfLabelText}" TextWrapping="Wrap"/>
                                                    </Border>
                                                    <TextBox Grid.Column="1" Style="{StaticResource CfFieldBox}"
                                                             AcceptsReturn="True" MinHeight="60"
                                                             Text="{Binding CfPointsRetenir, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- RESTITUTION PARENTS : 6 sections avec titre + textarea + reformuler -->
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRestitutionParents}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ItemsControl ItemsSource="{Binding RpSections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8" BorderBrush="#D6DBDF" BorderThickness="1" CornerRadius="4">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <!-- En-tête de section : titre + bouton Reformuler -->
                                                                <Border Grid.Row="0" Background="#EBF5FB" BorderBrush="#AED6F1"
                                                                        BorderThickness="0,0,0,1" CornerRadius="4,4,0,0" Padding="10,5">
                                                                    <DockPanel>
                                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="..." Foreground="#F39C12" FontSize="11" FontStyle="Italic"
                                                                                       VerticalAlignment="Center" Margin="0,0,6,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <Button Command="{Binding ToggleInstructionCommand}" Padding="7,3" FontSize="10" Cursor="Hand"
                                                                                    Background="#D6EAF8" BorderBrush="#AED6F1" BorderThickness="1">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}"
                                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="Background" Value="#AED6F1"/>
                                                                                            </Trigger>
                                                                                            <Trigger Property="IsEnabled" Value="False">
                                                                                                <Setter Property="Background" Value="#F2F3F4"/>
                                                                                                <Setter Property="BorderBrush" Value="#CCD1D1"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                                <Button.Content>
                                                                                    <TextBlock>
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Text" Value="↺ Reformuler"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsInstructionPanelVisible}" Value="True">
                                                                                                        <Setter Property="Text" Value="✕ Fermer"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </Button.Content>
                                                                            </Button>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                                   FontSize="12" Foreground="#1A5276" VerticalAlignment="Center"/>
                                                                    </DockPanel>
                                                                </Border>

                                                                <!-- Zone texte éditable -->
                                                                <TextBox Grid.Row="1"
                                                                         Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                                         MinHeight="70" MaxHeight="220"
                                                                         VerticalScrollBarVisibility="Auto"
                                                                         Padding="8,6" BorderThickness="0"
                                                                         FontFamily="Segoe UI" FontSize="12"/>

                                                                <!-- Panneau instruction inline (collapse/expand) -->
                                                                <Border Grid.Row="2" Background="#FEFDE7" BorderBrush="#F4D03F"
                                                                        BorderThickness="0,1,0,0" CornerRadius="0,0,4,4" Padding="10,8">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsInstructionPanelVisible}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <TextBlock Text="💡 Votre instruction de modification :"
                                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#7D6608" Margin="0,0,0,5"/>
                                                                        <TextBox Text="{Binding UserInstruction, UpdateSourceTrigger=PropertyChanged}"
                                                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                                                 MinHeight="52" MaxHeight="100"
                                                                                 VerticalScrollBarVisibility="Auto"
                                                                                 FontFamily="Segoe UI" FontSize="12"
                                                                                 BorderBrush="#F4D03F" BorderThickness="1" Padding="6,4"
                                                                                 Tag="Ex : raccourcis à 2 points, insiste sur la timidité, ton plus doux…"/>
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                                            <Button Command="{Binding CancelInstructionCommand}" Content="Annuler"
                                                                                    Padding="10,4" FontSize="11" Cursor="Hand" Margin="0,0,8,0"
                                                                                    Background="#F2F3F4" BorderBrush="#BDC3C7" BorderThickness="1">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E5E8E8"/></Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                            <Button Command="{Binding RegenerateCommand}" Content="✨ Régénérer"
                                                                                    Padding="10,4" FontSize="11" Cursor="Hand"
                                                                                    Background="#1ABC9C" Foreground="White" BorderThickness="0">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#16A085"/></Trigger>
                                                                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#BDC3C7"/></Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <!-- SYNTHESE DIAG S2 : Diagnostics retenus -->
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSyntheseDiagS2}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding DiagS2Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,10" BorderBrush="#AED6F1" BorderThickness="1" CornerRadius="6" Background="White">
                                                                <StackPanel>
                                                                    <!-- En-tête carte diag -->
                                                                    <Border Background="#D6EAF8" CornerRadius="5,5,0,0" Padding="10,7">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBox Grid.Column="0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                                                     FontWeight="SemiBold" FontSize="12" FontFamily="Segoe UI"
                                                                                     BorderThickness="0" Background="Transparent" Padding="0"
                                                                                     VerticalAlignment="Center"
                                                                                     Tag="Nom du diagnostic (ex : TDAH, TSA…)"/>
                                                                            <Button Grid.Column="1" Command="{Binding RemoveSelfCommand}"
                                                                                    Content="✕" Padding="5,2" FontSize="11" Cursor="Hand"
                                                                                    Background="Transparent" BorderThickness="0" Foreground="#E74C3C"
                                                                                    ToolTip="Supprimer ce diagnostic"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <StackPanel Margin="10,8,10,6">
                                                                        <!-- Certitude -->
                                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                            <TextBlock Text="Certitude :" FontSize="11" FontWeight="SemiBold"
                                                                                       Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                            <ComboBox SelectedItem="{Binding Certitude, Mode=TwoWay}"
                                                                                      ItemsSource="{x:Static vm:DiagRetenuVm.CertitudeOptions}"
                                                                                      FontSize="11" MinWidth="120" Padding="4,2"/>
                                                                        </StackPanel>
                                                                        <!-- Éléments cliniques -->
                                                                        <TextBlock Text="Éléments cliniques :" FontSize="11" FontWeight="SemiBold"
                                                                                   Foreground="#555" Margin="0,0,0,4"/>
                                                                        <ItemsControl ItemsSource="{Binding Elements}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="0,2,0,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBox Grid.Column="0"
                                                                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                                 FontSize="12" FontFamily="Segoe UI"
                                                                                                 Padding="5,3" BorderBrush="#D6DBDF" BorderThickness="1"
                                                                                                 AcceptsReturn="False" TextWrapping="Wrap"/>
                                                                                        <Button Grid.Column="1" Margin="4,0,0,0"
                                                                                                Command="{Binding DataContext.RemoveElementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Content="−" Padding="5,2" FontSize="12" Cursor="Hand"
                                                                                                Background="#FADBD8" BorderBrush="#F1948A" BorderThickness="1"
                                                                                                Foreground="#C0392B" ToolTip="Supprimer"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <Button Command="{Binding AddElementCommand}" Content="+ Ajouter un élément"
                                                                                HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                                Padding="7,3" FontSize="11" Cursor="Hand"
                                                                                Background="#EBF5FB" BorderBrush="#AED6F1" BorderThickness="1"
                                                                                Foreground="#1B4F72"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Command="{Binding AddDiagS2Command}" Content="＋ Ajouter un diagnostic retenu"
                                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                                        Padding="10,5" FontSize="12" Cursor="Hand"
                                                        Background="#D5F5E3" BorderBrush="#82E0AA" BorderThickness="1" Foreground="#1E8449"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- SYNTHESE DIAG S3 : Diagnostics écartés -->
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSyntheseDiagS3}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding DiagS3Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,10" BorderBrush="#F1948A" BorderThickness="1" CornerRadius="6" Background="White">
                                                                <StackPanel>
                                                                    <Border Background="#FADBD8" CornerRadius="5,5,0,0" Padding="10,7">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBox Grid.Column="0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                                                     FontWeight="SemiBold" FontSize="12" FontFamily="Segoe UI"
                                                                                     BorderThickness="0" Background="Transparent" Padding="0"
                                                                                     VerticalAlignment="Center"
                                                                                     Tag="Nom du diagnostic écarté"/>
                                                                            <Button Grid.Column="1" Command="{Binding RemoveSelfCommand}"
                                                                                    Content="✕" Padding="5,2" FontSize="11" Cursor="Hand"
                                                                                    Background="Transparent" BorderThickness="0" Foreground="#C0392B"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <StackPanel Margin="10,8,10,6">
                                                                        <TextBlock Text="Conclusion :" FontSize="11" FontWeight="SemiBold"
                                                                                   Foreground="#555" Margin="0,0,0,3"/>
                                                                        <TextBox Text="{Binding Conclusion, UpdateSourceTrigger=PropertyChanged}"
                                                                                 FontSize="12" FontFamily="Segoe UI" Padding="5,3"
                                                                                 BorderBrush="#D6DBDF" BorderThickness="1"
                                                                                 AcceptsReturn="False" TextWrapping="Wrap" Margin="0,0,0,6"
                                                                                 Tag="Ex : écarté — pas de critères suffisants"/>
                                                                        <TextBlock Text="Arguments :" FontSize="11" FontWeight="SemiBold"
                                                                                   Foreground="#555" Margin="0,0,0,4"/>
                                                                        <ItemsControl ItemsSource="{Binding Arguments}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="0,2,0,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBox Grid.Column="0"
                                                                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                                 FontSize="12" FontFamily="Segoe UI"
                                                                                                 Padding="5,3" BorderBrush="#D6DBDF" BorderThickness="1"
                                                                                                 AcceptsReturn="False" TextWrapping="Wrap"/>
                                                                                        <Button Grid.Column="1" Margin="4,0,0,0"
                                                                                                Command="{Binding DataContext.RemoveArgumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Content="−" Padding="5,2" FontSize="12" Cursor="Hand"
                                                                                                Background="#FADBD8" BorderBrush="#F1948A" BorderThickness="1"
                                                                                                Foreground="#C0392B"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <Button Command="{Binding AddArgumentCommand}" Content="+ Ajouter un argument"
                                                                                HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                                Padding="7,3" FontSize="11" Cursor="Hand"
                                                                                Background="#FADBD8" BorderBrush="#F1948A" BorderThickness="1"
                                                                                Foreground="#922B21"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Command="{Binding AddDiagS3Command}" Content="＋ Ajouter un diagnostic écarté"
                                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                                        Padding="10,5" FontSize="12" Cursor="Hand"
                                                        Background="#FADBD8" BorderBrush="#F1948A" BorderThickness="1" Foreground="#922B21"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- SYNTHESE DIAG S4 : Intégration cartographies -->
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSyntheseDiagS4}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <!-- Enfant -->
                                                <TextBlock Text="👶 Enfant" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#1B4F72" Margin="0,0,0,6"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Forces -->
                                                    <Border Grid.Column="0" BorderBrush="#82E0AA" BorderThickness="1" CornerRadius="6" Background="White">
                                                        <StackPanel>
                                                            <Border Background="#D5F5E3" CornerRadius="5,5,0,0" Padding="8,6">
                                                                <TextBlock Text="✅ Forces" FontWeight="SemiBold" FontSize="11" Foreground="#1E8449"/>
                                                            </Border>
                                                            <StackPanel Margin="8,6,8,6">
                                                                <ItemsControl ItemsSource="{Binding S4Vm.Forces}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2,0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBox Grid.Column="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                         FontSize="11" Padding="4,2" BorderBrush="#D6DBDF" BorderThickness="1" TextWrapping="Wrap"/>
                                                                                <Button Grid.Column="1" Margin="3,0,0,0"
                                                                                        Command="{Binding DataContext.S4Vm.RemoveForceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Content="−" Padding="4,1" FontSize="11" Cursor="Hand"
                                                                                        Background="#FADBD8" BorderBrush="#F1948A" BorderThickness="1" Foreground="#C0392B"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Button Command="{Binding S4Vm.AddForceCommand}" Content="+ Ajouter"
                                                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                        Padding="6,2" FontSize="10" Cursor="Hand"
                                                                        Background="#D5F5E3" BorderBrush="#82E0AA" BorderThickness="1" Foreground="#1E8449"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Fragilités -->
                                                    <Border Grid.Column="2" BorderBrush="#F1948A" BorderThickness="1" CornerRadius="6" Background="White">
                                                        <StackPanel>
                                                            <Border Background="#FADBD8" CornerRadius="5,5,0,0" Padding="8,6">
                                                                <TextBlock Text="⚠ Fragilités" FontWeight="SemiBold" FontSize="11" Foreground="#922B21"/>
                                                            </Border>
                                                            <StackPanel Margin="8,6,8,6">
                                                                <ItemsControl ItemsSource="{Binding S4Vm.Fragilites}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2,0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBox Grid.Column="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                         FontSize="11" Padding="4,2" BorderBrush="#D6DBDF" BorderThickness="1" TextWrapping="Wrap"/>
                                                                                <Button Grid.Column="1" Margin="3,0,0,0"
                                                                                        Command="{Binding DataContext.S4Vm.RemoveFragiliteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Content="−" Padding="4,1" FontSize="11" Cursor="Hand"
                                                                                        Background="#FADBD8" BorderBrush="#F1948A" BorderThickness="1" Foreground="#C0392B"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Button Command="{Binding S4Vm.AddFragiliteCommand}" Content="+ Ajouter"
                                                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                        Padding="6,2" FontSize="10" Cursor="Hand"
                                                                        Background="#FADBD8" BorderBrush="#F1948A" BorderThickness="1" Foreground="#922B21"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <!-- Environnement -->
                                                <TextBlock Text="🏠 Environnement" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#6E2FBF" Margin="0,4,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Protecteurs -->
                                                    <Border Grid.Column="0" BorderBrush="#A9CCE3" BorderThickness="1" CornerRadius="6" Background="White">
                                                        <StackPanel>
                                                            <Border Background="#D6EAF8" CornerRadius="5,5,0,0" Padding="8,6">
                                                                <TextBlock Text="🛡 Protecteurs" FontWeight="SemiBold" FontSize="11" Foreground="#1B4F72"/>
                                                            </Border>
                                                            <StackPanel Margin="8,6,8,6">
                                                                <ItemsControl ItemsSource="{Binding S4Vm.Protecteurs}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2,0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBox Grid.Column="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                         FontSize="11" Padding="4,2" BorderBrush="#D6DBDF" BorderThickness="1" TextWrapping="Wrap"/>
                                                                                <Button Grid.Column="1" Margin="3,0,0,0"
                                                                                        Command="{Binding DataContext.S4Vm.RemoveProtecteurCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Content="−" Padding="4,1" FontSize="11" Cursor="Hand"
                                                                                        Background="#FADBD8" BorderBrush="#F1948A" BorderThickness="1" Foreground="#C0392B"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Button Command="{Binding S4Vm.AddProtecteurCommand}" Content="+ Ajouter"
                                                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                        Padding="6,2" FontSize="10" Cursor="Hand"
                                                                        Background="#D6EAF8" BorderBrush="#A9CCE3" BorderThickness="1" Foreground="#1B4F72"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Aggravants -->
                                                    <Border Grid.Column="2" BorderBrush="#F0B27A" BorderThickness="1" CornerRadius="6" Background="White">
                                                        <StackPanel>
                                                            <Border Background="#FDEBD0" CornerRadius="5,5,0,0" Padding="8,6">
                                                                <TextBlock Text="🔥 Aggravants" FontWeight="SemiBold" FontSize="11" Foreground="#784212"/>
                                                            </Border>
                                                            <StackPanel Margin="8,6,8,6">
                                                                <ItemsControl ItemsSource="{Binding S4Vm.Aggravants}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2,0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBox Grid.Column="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                         FontSize="11" Padding="4,2" BorderBrush="#D6DBDF" BorderThickness="1" TextWrapping="Wrap"/>
                                                                                <Button Grid.Column="1" Margin="3,0,0,0"
                                                                                        Command="{Binding DataContext.S4Vm.RemoveAggravantCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Content="−" Padding="4,1" FontSize="11" Cursor="Hand"
                                                                                        Background="#FADBD8" BorderBrush="#F1948A" BorderThickness="1" Foreground="#C0392B"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Button Command="{Binding S4Vm.AddAggravantCommand}" Content="+ Ajouter"
                                                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                        Padding="6,2" FontSize="10" Cursor="Hand"
                                                                        Background="#FDEBD0" BorderBrush="#F0B27A" BorderThickness="1" Foreground="#784212"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- BLOCS PT : éditeur champ-par-champ avec reformulation par section -->
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPtBloc}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ItemsControl ItemsSource="{Binding PtFields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:PtFieldViewModel}">
                                                        <!-- Replié quand l'indication de la section a été écartée. Rien
                                                             n'est effacé : le contenu revient si le médecin change d'avis. -->
                                                        <Border Margin="0,0,0,8" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Background="White">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding MasqueParIndication}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <!-- En-tête section : titre + bouton Reformuler -->
                                                                <Border Background="#EBF5FB" CornerRadius="5,5,0,0" Padding="10,7">
                                                                    <DockPanel>
                                                                        <Button DockPanel.Dock="Right"
                                                                                Command="{Binding ToggleReformulePanelCommand}"
                                                                                Padding="7,3" FontSize="10" Cursor="Hand"
                                                                                Background="#D6EAF8" BorderBrush="#AED6F1" BorderThickness="1">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="{TemplateBinding Background}"
                                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#AED6F1"/></Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                            <TextBlock>
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="↺ Reformuler"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsReformulePanelVisible}" Value="True">
                                                                                                <Setter Property="Text" Value="✕ Fermer"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Button>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                                   FontSize="12" FontFamily="Segoe UI"
                                                                                   Foreground="#1B4F72" VerticalAlignment="Center"/>
                                                                    </DockPanel>
                                                                </Border>

                                                                <!-- Contenu texte (champ non-liste) -->
                                                                <TextBox Margin="8,6,8,6"
                                                                         Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="36"
                                                                         FontSize="12" FontFamily="Segoe UI" Padding="5,3"
                                                                         BorderBrush="#D6DBDF" BorderThickness="1">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox">
                                                                            <!-- Trois types de champs coexistent : ce TextBox n'est que
                                                                                 celui du texte libre. -->
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsText}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>

                                                                <!-- Contenu liste (champ liste) -->
                                                                <StackPanel Margin="8,6,8,6">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsList}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Margin="0,2,0,2">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBox Grid.Column="0"
                                                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                                             FontSize="12" FontFamily="Segoe UI"
                                                                                             Padding="5,3" BorderBrush="#D6DBDF" BorderThickness="1"
                                                                                             AcceptsReturn="False" TextWrapping="Wrap"/>
                                                                                    <Button Grid.Column="1" Margin="4,0,0,0"
                                                                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                            CommandParameter="{Binding}"
                                                                                            Content="−" Padding="5,2" FontSize="12" Cursor="Hand"
                                                                                            Background="#FADBD8" BorderBrush="#F1948A" BorderThickness="1"
                                                                                            Foreground="#C0392B"/>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <Button Command="{Binding AddItemCommand}" Content="+ Ajouter"
                                                                            HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                            Padding="7,3" FontSize="11" Cursor="Hand"
                                                                            Background="#EBF5FB" BorderBrush="#AED6F1" BorderThickness="1"
                                                                            Foreground="#1B4F72"/>
                                                                </StackPanel>

                                                                <!-- Contenu INDICATION : est-ce indiqué, à quel degré, par qui,
                                                                     pourquoi — et ce qui ferait reconsidérer si c'est différé. -->
                                                                <StackPanel Margin="8,6,8,6" DataContext="{Binding Indication}">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding DataContext.IsIndication, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                                            <TextBlock Text="DEGRÉ" FontSize="9" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                                                            <ComboBox ItemsSource="{Binding Degres}"
                                                                                      SelectedItem="{Binding Degre, Mode=TwoWay}"
                                                                                      IsEditable="False" FontSize="11" Padding="4,2"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                                            <TextBlock Text="QUI" FontSize="9" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                                                            <ComboBox ItemsSource="{Binding Porteurs}"
                                                                                      SelectedItem="{Binding Porteur, Mode=TwoWay}"
                                                                                      IsEditable="False" FontSize="11" Padding="4,2"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <TextBlock Text="MOTIF CLINIQUE" FontSize="9" Foreground="#7F8C8D"
                                                                               FontWeight="SemiBold" Margin="0,6,0,0"/>
                                                                    <TextBox Text="{Binding Motif, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="12" FontFamily="Segoe UI" Padding="5,3"
                                                                             BorderBrush="#D6DBDF" BorderThickness="1"
                                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="36"/>
                                                                    <TextBlock Text="À RECONSIDÉRER SI (si le suivi est différé)" FontSize="9"
                                                                               Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                                                    <TextBox Text="{Binding CritereReevaluation, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="11" FontFamily="Segoe UI" FontStyle="Italic" Padding="5,3"
                                                                             BorderBrush="#D6DBDF" BorderThickness="1"
                                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="30"/>

                                                                    <!-- Section écartée : on le dit, et on laisse la porte ouverte.
                                                                         Le bandeau et le lien n'apparaissent que dans ce cas. -->
                                                                    <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="4"
                                                                            Background="#FEF9E7" BorderBrush="#F1C40F" BorderThickness="1">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <!-- Le DataContext de ce panneau est déjà l'indication. -->
                                                                                    <DataTrigger Binding="{Binding EstEcartee}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <StackPanel>
                                                                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#7D6608"
                                                                                       Text="Section écartée — le dossier s'arrêtera au motif et à ce qui ferait reconsidérer. Les sous-sections sont repliées, rien n'est effacé."/>
                                                                            <Button Command="{Binding DataContext.BasculeSousSectionsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                    Content="{Binding DataContext.LibelleBasculeSousSections, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                    HorizontalAlignment="Left" Margin="0,5,0,0"
                                                                                    Padding="0" Cursor="Hand" FontSize="11"
                                                                                    Background="Transparent" BorderThickness="0" Foreground="#7D6608">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <TextBlock Text="{TemplateBinding Content}"
                                                                                                   TextDecorations="Underline"
                                                                                                   Foreground="{TemplateBinding Foreground}"
                                                                                                   FontSize="{TemplateBinding FontSize}"/>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Contenu ACTIONS : ce qu'on fait, qui le porte, pour quand,
                                                                     à quel degré — et pour les bilans, ce que ça tranche. -->
                                                                <StackPanel Margin="8,6,8,6">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActions}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <ItemsControl ItemsSource="{Binding Actions}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate DataType="{x:Type vm:PtActionVm}">
                                                                                <Border Margin="0,0,0,6" Padding="7,6"
                                                                                        Background="#FBFCFD" BorderBrush="#E1E6EA"
                                                                                        BorderThickness="1" CornerRadius="4">
                                                                                    <StackPanel>
                                                                                        <!-- Ligne 1 : l'action + supprimer -->
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBox Grid.Column="0"
                                                                                                     Text="{Binding Quoi, UpdateSourceTrigger=PropertyChanged}"
                                                                                                     FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold"
                                                                                                     Padding="5,3" BorderBrush="#D6DBDF" BorderThickness="1"
                                                                                                     AcceptsReturn="False" TextWrapping="Wrap"/>
                                                                                            <Button Grid.Column="1" Margin="4,0,0,0"
                                                                                                    Command="{Binding RemoveCommand}"
                                                                                                    Content="−" Padding="5,2" FontSize="12" Cursor="Hand"
                                                                                                    Background="#FADBD8" BorderBrush="#F1948A"
                                                                                                    BorderThickness="1" Foreground="#C0392B"/>
                                                                                        </Grid>

                                                                                        <!-- Ligne 2 : qui / quand / degré. Les ressources du
                                                                                             quotidien n'ont ni quand ni degré : elles s'installent. -->
                                                                                        <Grid Margin="0,5,0,0">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                                                                <!-- Dispositifs scolaires : le statut d'abord, car
                                                                                                     « déjà en place » change tout le reste du texte. -->
                                                                                                <StackPanel Margin="0,0,0,4">
                                                                                                    <StackPanel.Style>
                                                                                                        <Style TargetType="StackPanel">
                                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                            <Style.Triggers>
                                                                                                                <DataTrigger Binding="{Binding AfficherStatut}" Value="True">
                                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                                </DataTrigger>
                                                                                                            </Style.Triggers>
                                                                                                        </Style>
                                                                                                    </StackPanel.Style>
                                                                                                    <TextBlock Text="STATUT" FontSize="9" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                                                                                    <ComboBox ItemsSource="{Binding Statuts}"
                                                                                                              SelectedItem="{Binding Statut, Mode=TwoWay}"
                                                                                                              IsEditable="False" FontSize="11" Padding="4,2"/>
                                                                                                </StackPanel>
                                                                                                <TextBlock Text="QUI" FontSize="9" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                                                                                <ComboBox ItemsSource="{Binding Porteurs}"
                                                                                                          SelectedItem="{Binding Porteur, Mode=TwoWay}"
                                                                                                          IsEditable="False" FontSize="11" Padding="4,2"/>
                                                                                            </StackPanel>
                                                                                            <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                                                                                <StackPanel.Style>
                                                                                                    <Style TargetType="StackPanel">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding AfficherEcheanceEtDegre}" Value="True">
                                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </StackPanel.Style>
                                                                                                <TextBlock Text="QUAND" FontSize="9" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                                                                                <ComboBox ItemsSource="{Binding Echeances}"
                                                                                                          SelectedItem="{Binding Echeance, Mode=TwoWay}"
                                                                                                          IsEditable="False" FontSize="11" Padding="4,2"/>
                                                                                            </StackPanel>
                                                                                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                                                                <StackPanel.Style>
                                                                                                    <Style TargetType="StackPanel">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding AfficherEcheanceEtDegre}" Value="True">
                                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </StackPanel.Style>
                                                                                                <TextBlock Text="DEGRÉ" FontSize="9" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                                                                                <ComboBox ItemsSource="{Binding Degres}"
                                                                                                          SelectedItem="{Binding Degre, Mode=TwoWay}"
                                                                                                          IsEditable="False" FontSize="11" Padding="4,2"/>
                                                                                            </StackPanel>
                                                                                        </Grid>

                                                                                        <!-- Ligne 3 : ce que le bilan tranche (bilans uniquement) -->
                                                                                        <StackPanel Margin="0,5,0,0">
                                                                                            <StackPanel.Style>
                                                                                                <Style TargetType="StackPanel">
                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding AfficherPourTrancher}" Value="True">
                                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </StackPanel.Style>
                                                                                            <TextBlock Text="POUR TRANCHER" FontSize="9" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                                                                            <TextBox Text="{Binding PourTrancher, UpdateSourceTrigger=PropertyChanged}"
                                                                                                     FontSize="11" FontFamily="Segoe UI" FontStyle="Italic"
                                                                                                     Padding="5,3" BorderBrush="#D6DBDF" BorderThickness="1"
                                                                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="30"/>
                                                                                        </StackPanel>

                                                                                        <!-- Ligne 3 bis : ce que l'action vise (rééducations, ressources) -->
                                                                                        <StackPanel Margin="0,5,0,0">
                                                                                            <StackPanel.Style>
                                                                                                <Style TargetType="StackPanel">
                                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding AfficherObjectif}" Value="True">
                                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </StackPanel.Style>
                                                                                            <TextBlock Text="OBJECTIF VISÉ" FontSize="9" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                                                                            <TextBox Text="{Binding Objectif, UpdateSourceTrigger=PropertyChanged}"
                                                                                                     FontSize="11" FontFamily="Segoe UI" FontStyle="Italic"
                                                                                                     Padding="5,3" BorderBrush="#D6DBDF" BorderThickness="1"
                                                                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="30"/>
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <Button Command="{Binding AddActionCommand}" Content="+ Ajouter"
                                                                            HorizontalAlignment="Left" Margin="0,2,0,0"
                                                                            Padding="7,3" FontSize="11" Cursor="Hand"
                                                                            Background="#EBF5FB" BorderBrush="#AED6F1" BorderThickness="1"
                                                                            Foreground="#1B4F72"/>
                                                                </StackPanel>

                                                                <!-- Panneau reformulation (jaune, collapsible) -->
                                                                <Border Background="#FEFDE7" BorderBrush="#F4D03F"
                                                                        BorderThickness="1,0,1,1" CornerRadius="0,0,4,4" Padding="10,8">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsReformulePanelVisible}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <TextBlock Text="💡 Votre instruction de modification :"
                                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#7D6608" Margin="0,0,0,5"/>
                                                                        <TextBox Text="{Binding UserInstruction, UpdateSourceTrigger=PropertyChanged}"
                                                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                                                 MinHeight="44" MaxHeight="80" VerticalScrollBarVisibility="Auto"
                                                                                 FontFamily="Segoe UI" FontSize="12"
                                                                                 BorderBrush="#F4D03F" BorderThickness="1" Padding="6,4"/>
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                                            <Button Command="{Binding CancelReformulePanelCommand}" Content="Annuler"
                                                                                    Padding="10,4" FontSize="11" Cursor="Hand" Margin="0,0,8,0"
                                                                                    Background="#F2F3F4" BorderBrush="#BDC3C7" BorderThickness="1">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E5E8E8"/></Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                            <Button Command="{Binding RegenerateCommand}" Content="✨ Régénérer"
                                                                                    Padding="10,4" FontSize="11" Cursor="Hand"
                                                                                    Background="#1ABC9C" Foreground="White" BorderThickness="0">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#16A085"/></Trigger>
                                                                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#BDC3C7"/></Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <!-- AUTRES BLOCS : TextBox + panneau reformulation -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCouverture}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRestitutionParents}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsIdentification}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsContexteFamilial}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAntecedents}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSituationActuelle}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSyntheseDiagS2}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSyntheseDiagS3}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSyntheseDiagS4}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPtBloc}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBox Grid.Row="0"
                                                     Text="{Binding Contenu, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                                                     FontSize="13" FontFamily="Segoe UI" Padding="8"
                                                     BorderBrush="#D6DBDF" BorderThickness="1"/>

                                            <!-- Panneau instruction reformulation -->
                                            <Border Grid.Row="1" Background="#FEFDE7" BorderBrush="#F4D03F"
                                                    BorderThickness="1,0,1,1" CornerRadius="0,0,4,4" Padding="10,8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReformulePanelVisible}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="💡 Votre instruction de modification :"
                                                               FontSize="11" FontWeight="SemiBold" Foreground="#7D6608" Margin="0,0,0,5"/>
                                                    <TextBox Text="{Binding ReformuleInstruction, UpdateSourceTrigger=PropertyChanged}"
                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                             MinHeight="52" MaxHeight="100"
                                                             VerticalScrollBarVisibility="Auto"
                                                             FontFamily="Segoe UI" FontSize="12"
                                                             BorderBrush="#F4D03F" BorderThickness="1" Padding="6,4"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                        <Button Command="{Binding CancelReformulePanelCommand}" Content="Annuler"
                                                                Padding="10,4" FontSize="11" Cursor="Hand" Margin="0,0,8,0"
                                                                Background="#F2F3F4" BorderBrush="#BDC3C7" BorderThickness="1">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E5E8E8"/></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Command="{Binding RegenerateCommand}" Content="✨ Régénérer"
                                                                Padding="10,4" FontSize="11" Cursor="Hand"
                                                                Background="#1ABC9C" Foreground="White" BorderThickness="0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#16A085"/></Trigger>
                                                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#BDC3C7"/></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ANNEXES — fiches de la bibliothèque d'infographies.
                 Med propose celles dont un sujet est cité dans le dossier ; il n'en joint aucune. -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,4,0,20"
                    BorderBrush="#D0D7DE" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🖼 Annexes — Fiches d'information" FontSize="15" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="{Binding AnnexesInfographiesResume}" FontSize="11" Foreground="#7F8C8D"
                               TextWrapping="Wrap" Margin="0,3,0,10"/>

                    <ItemsControl ItemsSource="{Binding AnnexesInfographies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E8E8" BorderThickness="1" CornerRadius="5"
                                        Padding="8" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EstJointe}" Value="True">
                                                    <Setter Property="Background" Value="#EAF7F0"/>
                                                    <Setter Property="BorderBrush" Value="#A9DFBF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding EstJointe, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                                  ToolTip="Joindre cette fiche en annexe du dossier"/>

                                        <Border Grid.Column="1" Background="#F4F6F7" Height="56" CornerRadius="3">
                                            <Image Source="{Binding Miniature}" Stretch="Uniform"/>
                                        </Border>

                                        <StackPanel Grid.Column="2" Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Titre}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#2C3E50" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Resume}" FontSize="10" Foreground="#7F8C8D"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding RaisonSuggestion}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#1F618D" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding Suggeree, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- PANNEAU QUALITÉ — prend la place de l'éditeur, l'aperçu reste à droite.
             On regarde la page dont on parle pendant qu'on corrige. -->
        <Border Grid.Column="0" Margin="0,0,10,0" Background="White" CornerRadius="8"
                BorderBrush="#D0D7DE" BorderThickness="1"
                Visibility="{Binding ModeQualite, Converter={StaticResource BoolToVis}}">
            <DockPanel>

                <!-- En-tête du panneau -->
                <Border DockPanel.Dock="Top" Background="#F4ECF7" CornerRadius="7,7,0,0" Padding="14,11"
                        BorderBrush="#D7BDE2" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding FermerQualiteCommand}"
                                Content="✕ Revenir à l'éditeur" Padding="9,5" FontSize="11" Cursor="Hand"
                                Background="White" BorderBrush="#D7BDE2" BorderThickness="1" Foreground="#5B2C6F">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EBDEF0"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Contrôle qualité du dossier" FontSize="15" FontWeight="Bold" Foreground="#4A235A"/>
                            <TextBlock Text="Trois phases. Rien ne se corrige tout seul — vous décidez à chaque point."
                                       FontSize="11" Foreground="#7D6B8A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Choix du moteur, pour les phases 2 et 3 -->
                <Border DockPanel.Dock="Top" Padding="14,10" Background="#FBFCFD"
                        BorderBrush="#E8EDF3" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MOTEUR" FontSize="9" FontWeight="SemiBold" Foreground="#7F8C8D"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding MoteursQualite}"
                                      SelectedItem="{Binding MoteurQualite, Mode=TwoWay}"
                                      Width="120" FontSize="11" Padding="4,2"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#95A5A6" Margin="0,6,0,0"
                                   Text="Sert aux phases 2 et 3. Chaque constat porte le nom du moteur qui l&#39;a produit — pour comparer, lancez les deux AVANT d&#39;accepter quoi que ce soit : une correction déjà appliquée change le texte que le second moteur lira."/>
                    </StackPanel>
                </Border>

                <!-- Phase 1 -->
                <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding LancerPhase1Command}"
                                    Padding="12,6" FontSize="11" Cursor="Hand" VerticalAlignment="Top"
                                    Background="#6C3483" Foreground="White" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#5B2C6F"/></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#BDC3C7"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Mesurer les pages"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Phase1EnCours}" Value="True">
                                                    <Setter Property="Text" Value="⏳ Mesure…"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="1 · Mise en page" FontSize="12" FontWeight="SemiBold" Foreground="#1B4F72"/>
                                <TextBlock Text="{Binding Phase1Resume}" FontSize="11" Foreground="#16A085" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#95A5A6" Margin="0,7,0,0"
                                   Text="Les pages sont déjà réparties automatiquement : dès qu&#39;un bloc ferait dépasser l&#39;A4, une page est ajoutée. Ce que la mesure signale ici est donc ce que la répartition n&#39;a PAS pu corriger — un bloc trop haut pour tenir sur une page, où qu&#39;on le mette. La seule issue est alors de raccourcir son texte."/>
                    </StackPanel>
                </Border>

                <!-- Phase 2 — première couche : le document confronté à ses propres règles.
                     Aucun modèle n'intervient ici, d'où l'absence d'estampille moteur. -->
                <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding LancerPhase2Command}"
                                    Padding="12,6" FontSize="11" Cursor="Hand" VerticalAlignment="Top"
                                    Background="#6C3483" Foreground="White" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#5B2C6F"/></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#BDC3C7"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Relire le document"/>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="2 · Contradictions" FontSize="12" FontWeight="SemiBold" Foreground="#1B4F72"/>
                                <TextBlock Text="{Binding Phase2Resume}" FontSize="11" Foreground="#16A085" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#95A5A6" Margin="0,7,0,0"
                                   Text="Relit le TEXTE PRODUIT, jamais le dossier patient : la vérification des informations reste la vôtre. Cette première couche ne consulte aucun modèle — elle vérifie que le document respecte ses propres règles, par exemple qu&#39;il ne cite pas la cartographie avant de l&#39;avoir présentée au lecteur."/>
                    </StackPanel>
                </Border>

                <!-- Phase 3 — langue. Deux couches : les tournures qu'on sait nommer (sans modèle),
                     puis la relecture par le moteur choisi, qui PROPOSE sans jamais appliquer. -->
                <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding LancerPhase3Command}"
                                    Padding="12,6" FontSize="11" Cursor="Hand" VerticalAlignment="Top"
                                    Background="#6C3483" Foreground="White" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#5B2C6F"/></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#BDC3C7"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Relire la langue"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Phase3EnCours}" Value="True">
                                                    <Setter Property="Text" Value="⏳ Relecture…"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="3 · Langue" FontSize="12" FontWeight="SemiBold" Foreground="#1B4F72"/>
                                <TextBlock Text="{Binding Phase3Resume}" FontSize="11" Foreground="#16A085" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#95A5A6" Margin="0,7,0,0"
                                   Text="Tournures lourdes, phrases mal construites, répétitions d&#39;une section à l&#39;autre. Le moteur PROPOSE : rien n&#39;est modifié tant que vous n&#39;avez pas accepté. Les valeurs choisies dans une liste (porteur, échéance, degré, statut) ne sont jamais relues ni réécrites — elles commandent les pastilles, l&#39;annexe contacts et le tri de la feuille de route."/>
                    </StackPanel>
                </Border>

                <!-- Les constats -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <ItemsControl ItemsSource="{Binding Constats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,7" Padding="10,8" CornerRadius="5"
                                        Background="#FBFCFD" BorderBrush="#E8EDF3" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Pastille}"
                                                   Foreground="{Binding Couleur}" FontSize="13"
                                                   Margin="0,0,9,0" VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Ou}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#1B4F72" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding EtiquetteMoteur}" FontSize="10"
                                                           Foreground="#95A5A6" Margin="6,1,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#34495E"
                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>

                                            <!-- Réécriture proposée. Le texte d'origine reste affiché
                                                 au-dessus : on n'accepte pas une correction sans voir
                                                 ce qu'elle remplace. -->
                                            <StackPanel Margin="0,7,0,0"
                                                        Visibility="{Binding EstProposition, Converter={StaticResource BoolToVis}}">
                                                <Border Background="#FDF6F5" BorderBrush="#F2D7D5" BorderThickness="1"
                                                        CornerRadius="4" Padding="7,5">
                                                    <TextBlock Text="{Binding Original}" FontSize="10" Foreground="#7B7D7D"
                                                               TextWrapping="Wrap" TextDecorations="Strikethrough"/>
                                                </Border>
                                                <Border Background="#F1F9F5" BorderBrush="#ABEBC6" BorderThickness="1"
                                                        CornerRadius="4" Padding="7,5" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Proposition}" FontSize="11" Foreground="#186A3B"
                                                               TextWrapping="Wrap"/>
                                                </Border>
                                                <DockPanel Margin="0,6,0,0">
                                                    <Button DockPanel.Dock="Left"
                                                            Command="{Binding DataContext.AppliquerPropositionCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Accepter cette réécriture"
                                                            Padding="9,4" FontSize="10" Cursor="Hand"
                                                            Background="#16A085" Foreground="White" BorderThickness="0"
                                                            Visibility="{Binding ProposableEncore, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="✓ Appliquée au dossier" FontSize="10" Foreground="#16A085"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding Appliquee, Converter={StaticResource BoolToVis}}"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#D0D7DE" ShowsPreview="True"
                          ToolTip="Faites glisser pour ajuster la largeur de l'aperçu"/>

            <!-- Preview WebView2 -->
            <Border Grid.Column="2" Background="#DDDDDD" CornerRadius="6" BorderBrush="#C0C7CC" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="PreviewFallback"
                               Text="📄 Aperçu en cours d'initialisation..."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" Foreground="#7F8C8D" FontStyle="Italic"/>
                    <wv2:WebView2 x:Name="PreviewWebView" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,15,0,0">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="-1" BlurRadius="4" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- Contrôle qualité — AVANT l'export, pas après : les phases 2 et 3 modifient
                     les blocs, donc le PDF. Contrôler après obligerait à réexporter. -->
                <Button Grid.Column="0" HorizontalAlignment="Left"
                        Command="{Binding OuvrirQualiteCommand}"
                        Content="🔍 Qualité"
                        Padding="15,8" Background="White" Foreground="#5B2C6F"
                        BorderBrush="#D7BDE2" BorderThickness="1" Cursor="Hand"
                        Visibility="{Binding ModeQualite, Converter={StaticResource BoolToVisInverse}}"
                        ToolTip="Vérifie la mise en page, les contradictions et la fluidité avant d&#39;exporter">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4ECF7"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Export PDF -->
                <Button x:Name="ExportPdfButton" Grid.Column="1"
                        Content="🖨 Exporter PDF"
                        Click="ExportPdfButton_Click"
                        Padding="15,8" Background="#6C3483" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                        ToolTip="Génère un PDF complet du dossier via Edge (identique à l'aperçu)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#5B2C6F"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#BDC3C7"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Command="{Binding SaveCommand}" Content="💾 Enregistrer" 
                        Padding="15,8" Background="#E67E22" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D35400"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="3" Command="{Binding CloseCommand}" Content="✕ Fermer" 
                        Padding="15,8" Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#7F8C8D"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
