<Window x:Class="MedCompanion.Views.Infographies.InfographiesBibliothequeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bibliothèque d'infographies"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Language="fr-FR"
        Background="#F8F9FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FiltreCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" MinWidth="320"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Gauche : filtres + miniatures ══ -->
        <Border Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Style="{StaticResource FiltreCombo}" ToolTip="Type"
                              ItemsSource="{Binding TypesFiltre}" SelectedItem="{Binding FiltreType}"/>
                    <ComboBox Grid.Column="1" Style="{StaticResource FiltreCombo}" ToolTip="Sujet"
                              ItemsSource="{Binding SujetsFiltre}" SelectedItem="{Binding FiltreSujet}"/>
                    <ComboBox Grid.Column="2" Style="{StaticResource FiltreCombo}" ToolTip="Public" Margin="0"
                              ItemsSource="{Binding PublicsFiltre}" SelectedItem="{Binding FiltrePublic}"/>
                </Grid>

                <TextBox x:Name="RechercheBox" Grid.Row="1" Margin="0,6,0,8" Padding="6,5" FontSize="13"
                         Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Rechercher : TDAH, sommeil, méthylphénidate…"/>

                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding Cartes}" SelectedItem="{Binding Selection}"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="Liste_MouseDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,6,6"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="180" BorderBrush="#E5E8E8" BorderThickness="1" CornerRadius="5" Padding="6">
                                    <StackPanel>
                                        <Border Background="#F4F6F7" Height="105" CornerRadius="3">
                                            <Image Source="{Binding Miniature}" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="#2C3E50" TextWrapping="Wrap" Margin="0,5,0,0"
                                                   MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Resume}" FontSize="10" Foreground="#7F8C8D"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding RemiseTexte}" FontSize="10" Foreground="#1F618D"
                                                   Visibility="{Binding DejaRemise, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding MessageVide}" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="#95A5A6" FontSize="13" VerticalAlignment="Center" Margin="10"
                               Visibility="{Binding EstVide, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Aucune fiche ne correspond aux filtres." TextAlignment="Center"
                               Foreground="#95A5A6" FontSize="13" VerticalAlignment="Center"
                               Visibility="{Binding AucunResultat, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ══ Droite : aperçu + impression ══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#E5E8E8" CornerRadius="6" Padding="12">
                <Image Source="{Binding ImageSelection}" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="🖨 Imprimer" Click="Imprimer_Click"
                        Style="{StaticResource ToolBtn}" Background="#27AE60"
                        IsEnabled="{Binding ASelection}"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Selection.Titre}" FontSize="15" FontWeight="SemiBold"
                               Foreground="#2C3E50" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Selection.Resume}" FontSize="11" Foreground="#7F8C8D"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Statut}" FontSize="11" Foreground="#5D6D7E"
                   Margin="4,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
