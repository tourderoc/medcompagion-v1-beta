<UserControl x:Class="MedCompanion.Views.Consultation.CartePatientControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:carte="clr-namespace:MedCompanion.Models.Carte"
             xmlns:conv="clr-namespace:MedCompanion.Converters"
             Background="Transparent">
    <!-- Carte du patient (PLAN_CARTE_PATIENT.md) : affichée à la place du dossier bleu, au même
         format de page. DataContext = ConsultationModeViewModel ; tout se lit dans Carte. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Une ligne : intitulé facultatif + valeur. Gris italique quand l'information manque.
             Runs en OneWay : un Run se lie en TwoWay par défaut, ce qui lève une exception sur une
             propriété en lecture seule (constaté le 24/09/2026 dans l'agenda). -->
        <DataTemplate x:Key="LigneTemplate" DataType="{x:Type carte:LigneCarte}">
            <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Margin="0,0,0,1"
                       Tag="{Binding Source, Mode=OneWay}" MouseLeftButtonUp="Ligne_Click">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Vide}" Value="True">
                                <Setter Property="Foreground" Value="#A0AEC0"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                            <!-- Une ligne qui a un document source s'ouvre au clic -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Vide}" Value="False"/>
                                    <Condition Binding="{Binding ASource}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ToolTip" Value="Ouvrir le document"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding LibelleAvecDeuxPoints, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Valeur, Mode=OneWay}"/>
            </TextBlock>
        </DataTemplate>

        <!-- Un bloc : icône, titre, origine des informations, puis ses lignes -->
        <DataTemplate x:Key="BlocTemplate" DataType="{x:Type carte:BlocCarte}">
            <Border Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="10" Padding="11,8,11,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,5" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" FontSize="12.5" FontWeight="Bold" Foreground="#0F4C5C">
                            <Run Text="{Binding Icone, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Titre, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Origine}" FontSize="9.5" Foreground="#A0AEC0"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Lignes}" ItemTemplate="{StaticResource LigneTemplate}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <!-- 595 de large en page (dossier bleu) ; 1240 en plein écran (F3) : AppliquerDisposition -->
        <Border x:Name="Page" Width="595" Height="842" Background="White" CornerRadius="6"
                BorderBrush="#5F9EAE" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="5" BlurRadius="15" Opacity="0.25" Color="#2C3E50"/>
            </Border.Effect>
            <Grid Margin="20,16,20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="CARTE DU PATIENT" FontSize="19" FontWeight="Bold"
                               Foreground="#1E293B" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="✕ Dossier" Command="{Binding FermerCarteCommand}"
                            FontSize="11" Padding="10,4" Cursor="Hand" Background="#F1F5F9" BorderBrush="#CBD5E1"
                            ToolTip="Revenir au dossier bleu"/>
                    <!-- Plein écran : le mode F3 du dossier, où la carte se déploie en étoile -->
                    <Button DockPanel.Dock="Right" Content="⛶ Plein écran" Command="{Binding SwitchToDossierCommand}"
                            FontSize="11" Padding="10,4" Margin="0,0,8,0" Cursor="Hand" Background="#F1F5F9" BorderBrush="#CBD5E1"
                            Visibility="{Binding IsFocusDossier, Converter={StaticResource InverseBoolToVis}}"
                            ToolTip="Agrandir la carte (F3)"/>
                    <Button DockPanel.Dock="Right" Content="↙ Réduire" Command="{Binding SwitchToConsultationCommand}"
                            FontSize="11" Padding="10,4" Margin="0,0,8,0" Cursor="Hand" Background="#F1F5F9" BorderBrush="#CBD5E1"
                            Visibility="{Binding IsFocusDossier, Converter={StaticResource BoolToVis}}"
                            ToolTip="Revenir à l'écran partagé (F2)"/>
                    <!-- Étape 2 : compléter depuis les notes ce qui manque (dossiers anciens surtout) -->
                    <Button DockPanel.Dock="Right" Content="✨ Compléter avec Med" Command="{Binding CompleterCarteCommand}"
                            FontSize="11" Padding="10,4" Margin="0,0,8,0" Cursor="Hand"
                            Background="#EAF4F7" BorderBrush="#5F9EAE" Foreground="#0F4C5C"
                            Visibility="{Binding Carte.PeutCompleter, Converter={StaticResource BoolToVis}}"
                            ToolTip="Med relit les notes et vous propose ce qui manque ; rien n'entre sans votre validation"/>
                    <TextBlock DockPanel.Dock="Right" FontSize="10" Foreground="#94A3B8" Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Text="{Binding Carte.CalculeeLe, StringFormat='lu dans le dossier à {0:HH\\hmm}'}"/>
                </DockPanel>
                <TextBlock Grid.Row="0" Text="{Binding CarteStatut}" FontSize="11" Foreground="#B9770E"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="Plan">
                        <!-- Les traits, dessinés derrière les blocs une fois la mise en page faite -->
                        <Canvas x:Name="Traits" IsHitTestVisible="False"/>

                        <!-- Places des blocs fixées par AppliquerDisposition (code associé) : deux
                             colonnes en page, trois en plein écran, l'enfant toujours au centre. -->
                        <Grid x:Name="Disposition">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="Col0" Width="*"/>
                                <ColumnDefinition x:Name="Col1" Width="28"/>
                                <ColumnDefinition x:Name="Col2" Width="*"/>
                                <ColumnDefinition x:Name="Col3" Width="0"/>
                                <ColumnDefinition x:Name="Col4" Width="0"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ContentControl x:Name="BlocFamille" Grid.Row="0" Grid.Column="0" Margin="0,0,0,10"
                                            Content="{Binding Carte.Famille}" ContentTemplate="{StaticResource BlocTemplate}"/>
                            <ContentControl x:Name="BlocMotif" Grid.Row="0" Grid.Column="2" Margin="0,0,0,10"
                                            Content="{Binding Carte.Motif}" ContentTemplate="{StaticResource BlocTemplate}"/>

                            <!-- L'enfant, au centre -->
                            <Border x:Name="Centre" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                    HorizontalAlignment="Center" Width="320" Margin="0,4,0,14"
                                    Background="#EAF4F7" BorderBrush="#5F9EAE" BorderThickness="2" CornerRadius="14"
                                    Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Carte.Nom}" FontSize="19" FontWeight="Bold"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Carte.AgeNaissance}" FontSize="12.5" Foreground="#64748B"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Carte.Scolarite}" FontSize="12.5" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Carte.ScolariteVide}" Value="True">
                                                        <Setter Property="Foreground" Value="#A0AEC0"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <ContentControl x:Name="BlocSuivi" Grid.Row="2" Grid.Column="0" Margin="0,0,0,10"
                                            Content="{Binding Carte.Suivi}" ContentTemplate="{StaticResource BlocTemplate}"/>
                            <ContentControl x:Name="BlocBilans" Grid.Row="2" Grid.Column="2" Margin="0,0,0,10"
                                            Content="{Binding Carte.Bilans}" ContentTemplate="{StaticResource BlocTemplate}"/>
                            <ContentControl x:Name="BlocCourriers" Grid.Row="3" Grid.Column="0" Margin="0,0,0,10"
                                            Content="{Binding Carte.Courriers}" ContentTemplate="{StaticResource BlocTemplate}"/>
                            <ContentControl x:Name="BlocTraitement" Grid.Row="3" Grid.Column="2" Margin="0,0,0,10"
                                            Content="{Binding Carte.Traitement}" ContentTemplate="{StaticResource BlocTemplate}"/>
                            <ContentControl x:Name="BlocAutour" Grid.Row="4" Grid.Column="0" Margin="0,0,0,10"
                                            Content="{Binding Carte.Autour}" ContentTemplate="{StaticResource BlocTemplate}"/>
                            <!-- Points ouverts : ce qui attend une action (matière du futur rôle d'interne) -->
                            <ContentControl x:Name="BlocPoints" Grid.Row="4" Grid.Column="2" Margin="0,0,0,10"
                                            Content="{Binding Carte.PointsOuverts}" ContentTemplate="{StaticResource BlocTemplate}"/>

                            <!-- Le parcours 3-11 ans -->
                            <Border x:Name="BlocParcours" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#CBD5E1"
                                    BorderThickness="0,1,0,0" Padding="0,8,0,0"
                                    Visibility="{Binding Carte.AParcours, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="🧭 PARCOURS 3-11 ANS" FontSize="12" FontWeight="Bold"
                                               Foreground="#0F4C5C" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding Carte.Parcours}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type carte:EtapeParcours}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border CornerRadius="6" BorderThickness="1" Padding="7,3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="BorderBrush" Value="#DFE6EE"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Etat}" Value="Fait">
                                                                        <Setter Property="Background" Value="#E9F7EF"/>
                                                                        <Setter Property="BorderBrush" Value="#A9DFBF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Etat}" Value="EnCours">
                                                                        <Setter Property="Background" Value="#EBF5FB"/>
                                                                        <Setter Property="BorderBrush" Value="#85C1E9"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Etat}" Value="Prochaine">
                                                                        <Setter Property="Background" Value="#FEF9E7"/>
                                                                        <Setter Property="BorderBrush" Value="#F5CBA7"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Texte}" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#A0AEC0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Etat}" Value="Fait">
                                                                            <Setter Property="Foreground" Value="#1E8449"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Etat}" Value="EnCours">
                                                                            <Setter Property="Foreground" Value="#1F618D"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Etat}" Value="Prochaine">
                                                                            <Setter Property="Foreground" Value="#B9770E"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="›" Foreground="#A0AEC0" Margin="4,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Derniere}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Viewbox>
</UserControl>
